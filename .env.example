SIYA_SECRET_KEY=replace-with-a-long-random-production-secret
SIYA_DEBUG=true
SIYA_ALLOWED_HOSTS=127.0.0.1,localhost
SIYA_CSRF_TRUSTED_ORIGINS=

# Use console email locally. Configure SMTP values in the deployment environment.
SIYA_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SIYA_EMAIL_HOST=
SIYA_EMAIL_PORT=465
SIYA_EMAIL_USE_SSL=true
SIYA_EMAIL_HOST_USER=
SIYA_EMAIL_PASSWORD=
SIYA_DEFAULT_FROM_EMAIL=Siya Real Build <noreply@example.com>

# Enable only after HTTPS is configured.
SIYA_SECURE_SSL_REDIRECT=false
SIYA_SESSION_COOKIE_SECURE=false
SIYA_CSRF_COOKIE_SECURE=false
SIYA_SECURE_HSTS_SECONDS=0
SIYA_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SIYA_SECURE_HSTS_PRELOAD=false
SIYA_LOG_LEVEL=INFO
SIYA_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SIYA_AUTH_RATE_LIMIT_EMAIL_ATTEMPTS=8
SIYA_AUTH_RATE_LIMIT_IP_ATTEMPTS=30
SIYA_SUPPORT_RATE_LIMIT_ATTEMPTS=5
